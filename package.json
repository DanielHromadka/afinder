{
  "name": "afinder",
  "productName": "aFinder",
  "version": "1.1.0",
  "description": "Windows XP style file manager for macOS, Windows and Linux",
  "author": "attosoft",
  "license": "GPL-3.0-or-later",
  "homepage": "https://afinder.pages.dev/",
  "desktopName": "afinder.desktop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint src/renderer",
    "test:automations": "npm run build && electron scripts/smoke-automations.cjs",
    "build:input": "node scripts/build-input.cjs",
    "dist": "npm run build && npm run build:input && electron-builder --mac",
    "dist:mas": "npm run build && electron-builder --mac mas --universal",
    "dist:win": "npm run build && npm run build:input && electron-builder --win",
    "dist:linux": "npm run build && npm run build:input && electron-builder --linux",
    "icons": "electron scripts/make-icons.cjs",
    "postinstall": "electron-builder install-app-deps",
    "test:workspace": "npm run build && electron scripts/smoke-workspace.cjs",
    "test:activity": "npm run build && electron scripts/smoke-activity.cjs",
    "test:file-assistant": "npm run build && electron scripts/smoke-file-assistant.cjs",
    "test:companion": "npm run build && electron scripts/smoke-companion.cjs",
    "test:feedback": "npm run build && electron scripts/smoke-feedback.cjs",
    "test:tools": "npm run build && electron scripts/smoke-tools.cjs",
    "test:tour": "npm run build && electron scripts/smoke-tour.cjs",
    "test:doom": "npm run build && electron scripts/smoke-doom.cjs",
    "test:docker": "npm run build && electron scripts/smoke-docker.cjs",
    "release-notes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release-notes.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "@azure/msal-node": "^7.0.1",
    "@huggingface/tokenizers": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2",
    "mammoth": "^1.13.0",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.12",
    "ssh2-sftp-client": "^12.1.1",
    "systeminformation": "^5.33.15",
    "tar-stream": "^3.2.2",
    "three": "^0.186.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/tar-stream": "^3.1.5",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "monaco-editor": "^0.57.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "cpu-features": "file:../../scripts/no-cpu-features",
    "dompurify": "^3.4.17"
  }
}
