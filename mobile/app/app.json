{
  "expo": {
    "name": "aFinder",
    "slug": "afinder",
    "version": "1.1.15",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.attosoft.afinder",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.attosoft.afinder",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "aFinder uses the camera only to scan the pairing QR code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "aFinder needs your photos only to upload the ones you pick to your computer.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-localization",
      "expo-font",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "aFinder uses the camera only to scan the pairing QR code shown on your computer.",
          "microphonePermission": "aFinder never records audio; it only shows your computer screen."
        }
      ],
      "expo-screen-orientation"
    ],
    "scheme": "afinder"
  }
}
