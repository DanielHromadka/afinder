{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Shared files (../../src/shared) resolve @noble/* from this app, as in metro.config.js; CI has no root node_modules.
    "paths": { "@noble/*": ["./node_modules/@noble/*"] }
  },
  "include": [
    "index.ts",
    "src"
  ]
}
